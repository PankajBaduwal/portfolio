# Contact form delivery (optional; without either, FormSubmit sends to profile.email). Set ONE of these in Vercel → Project → Settings → Environment Variables.
# Web3Forms: free key from https://web3forms.com (the key is designed to be public).
VITE_WEB3FORMS_KEY=
# Or any endpoint that accepts a JSON POST, e.g. Formspree: https://formspree.io/f/xxxxxxx
VITE_CONTACT_ENDPOINT=
